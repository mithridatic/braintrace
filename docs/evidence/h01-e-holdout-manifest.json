{
  "image": "braintrace-h01-neuron:9.0.2",
  "cache_dir": ".cache/human-pyramidal-l2",
  "library": "kv3-closing-source",
  "driver": "h01_l2_neuron_reference.py",
  "output_dir": "h01-e-energetic",
  "max_concurrent": 2,
  "abort_seconds": 2100,
  "purpose": "Stage 4 holdout prediction for the E candidate at sweep 53; prediction written first in h01-prediction-e.json.",
  "cap": 1,
  "prior_evaluations": 0,
  "inputs": {
    "sweep53": [
      "--cache",
      "/work",
      "--sweep",
      "53",
      "--include-recorded-bias"
    ]
  },
  "holdout": "this manifest opens it once",
  "stages": {
    "P": {
      "title": "Holdout prediction",
      "prediction": "see h01-prediction-e.json",
      "rejection": "any claimed row outside its limit",
      "unchanged": "as the energetic manifest",
      "decision_file": "stage-p-decision.json"
    }
  },
  "candidates": [
    {
      "name": "p-candidate",
      "stage": "P",
      "flags": {
        "calcium_decay_factor": 1.33,
        "distribute_ih": true,
        "ih_density_factor": 75.0,
        "kv3_closing_factor": 0.9,
        "leak_reversal_shift_mv": -4.0,
        "sodium_density_factor": 1.3,
        "sodium_opening_factor": 2.0,
        "sodium_recovery_factor": 1.0
      },
      "settings": {
        "nseg_factor": 9,
        "cvode_atol": 1e-10,
        "stop_ms": 2100.0,
        "record_soma_currents": true
      }
    }
  ]
}
